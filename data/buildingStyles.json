{
  "_doc": {
    "about": "Faction styles of procedural buildings (src/procedural, docs/BUILDING-STYLE.md, docs/notes/proc-style-kit.md). Keys = race keys of stats.json (X/Y/Z…); a race that is not here uses the FIRST style. Keys starting with '_' are not styles. Code reads only the properties, never the faction names; 'label' is documentation.",
    "_defaults": "merged under every style (missing properties)",
    "silhouette": "shape family the building modules pick their shapes by: rounded | angular | round | faceted",
    "edges": "{ radius (model units), segments (0 = sharp, 1 = chamfer, 2+ = round) } – big volumes only",
    "neon": "0..1 strength of neon strips / windows (glow and number of extra veins)",
    "neonTeam": "true = neon strips glow in the team colour",
    "lights": "neon (lens + coloured halo) | lamp (classic caged warm bulb)",
    "fan": "guarded (grille) | open (bare blades) | radiator (fins glowing while producing) | none (plasma orb instead)",
    "crane": "gantry | heavyGantry | plasma (emitter + levitating ring, beam instead of hook) | tractorBeam (laser carries the load)",
    "roofRails": "number of roof guide rails the crane runs on",
    "markings": "hazard (yellow/black stripes) | light (thin neon lines) | none",
    "industrial": "false = no pipes, tanks, chimneys, louvres",
    "texture": "panel texture: clean | worn | smooth | circuit (ProcKit PROC_KIT.textures)",
    "palette": "sRGB: base, secondary, metal, accent, neon (+ dark, ground, lower, window, interior, lamp, beacon, pipe, trim)",
    "surface": "metalness / roughness of the main hull",
    "reactorGlow": "glow colour of the advanced generator (tier 3)",
    "unit": "units (src/procedural/units): exhaust { kind ion|rocket|plasma|beam, outer, core, length, width, flicker }, hoverGlow, weaponGlow, plasma, cloak { minOpacity }",
    "anim": "tempo (speed multiplier of cranes), jerk (0..1 stepped piston-like travel), spin (fans / rings / radar), pulse (Hz of glow pulses), blink (s beacon period), glowRamp (1/s radiator heat-up), levitate (amplitude multiplier)",
    "emblem": "{ render: neon | paint, color (sRGB faction logo colour: UI and – PROC_EMBLEM mode 'faction', the default – the colour of the sign on buildings, never repainted by the team colour), plate (dark | light: neutral plate under the sign, in the decal), backlight (paint only, 0..1), paths: SVG path strings, viewBox 0 0 100 100, y down, closed subpaths, fill-rule evenodd (a subpath inside another is a hole) }",
    "teamPaint": "team-coloured surfaces (ProcModules teamStripe / teamPanel / teamTrim / teamBanner / roofMark; PROC_TEAM_PAINT in config.js): { mode (stripes | panels | mixed: what dominates), share (target share of the visible surface in the team colour, clamped to PROC_TEAM_PAINT.target 0.15..0.30), stripes (bands per stripe 1..6), stripeKind (band | slash | fine), panelKind (inset | plate | pearl | blade), banner (flag | pennant | orb | fin), trim (lip height multiplier, 0 = none), roofMark (roof / ground mark size multiplier, 0 = none; its shape follows silhouette) }"
  },
