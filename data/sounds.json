{
  "_doc": {
    "about": "Synthesized retro sounds (src/audio/Sound.js + Synth.js). Nothing here touches the simulation.",
    "events": "eventName -> { synth: patchId } | { file: 'path.ogg', synth?: fallbackPatchId } | { alias: otherEvent }. Optional: category ('effects'|'ui'), gain, priority (voice stealing weight), minIntervalMs, maxPerEvent. A file path is relative to AUDIO.basePath (sounds/). Missing file -> synth fallback, else silent.",
    "patches": "patchId -> { layers: [1-3 layers], gain?, pitchVar?, gainVar? }",
    "layer": "type: square|sawtooth|triangle|sine|pulse25|pulse12 (oscillators) or white|pink|crunch (noise). freq/freqEnd Hz (noise: rate/rateEnd = playback rate), sweep 'exp'|'lin', sweepTime s (default = layer length). Envelope a (attack), d (decay), s (sustain level 0-1), st (sustain time), r (release) in s; gain = peak; delay = start offset s. filter { type lowpass|highpass|bandpass, freq, freqEnd?, q?, time? }. notes [[semitones, start s, duration s, gain?], ...] = jingle on one oscillator (a/r used per note, freq = base note).",
    "weapons": "weapon id (stats.json) -> event; weapons not listed fall back by their data (Sound.js weaponSoundEvent)"
  },
  "events": {
    "shotCannon":        { "synth": "shotCannon", "priority": 2, "minIntervalMs": 50, "maxPerEvent": 4 },
